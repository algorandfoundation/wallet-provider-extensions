{
  "name": "@algorandfoundation/keystore",
  "version": "1.0.0-canary.21",
  "description": "Meta package that resolves to the right platform keystore implementation (node/web/react-native).",
  "license": "Apache-2.0",
  "author": "Algorand Foundation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/algorandfoundation/wallet-provider-extensions.git",
    "directory": "keystore/meta"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.native.d.ts",
        "default": "./dist/index.native.js"
      },
      "browser": {
        "types": "./dist/index.web.d.ts",
        "default": "./dist/index.web.js"
      },
      "node": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage node_modules",
    "docs": "typedoc",
    "test": "vitest run --passWithNoTests",
    "test:cov": "vitest run --coverage --passWithNoTests",
    "bench": "vitest bench",
    "release": "package-releaser",
    "release:dry-run": "package-releaser --dry-run"
  },
  "dependencies": {
    "@algorandfoundation/keystore-core": "workspace:*",
    "@algorandfoundation/keystore-node": "workspace:*",
    "@algorandfoundation/keystore-web": "workspace:*",
    "@algorandfoundation/react-native-keystore": "workspace:*"
  },
  "devDependencies": {
    "@algorandfoundation/log-store": "workspace:*",
    "@algorandfoundation/package-releaser": "workspace:^",
    "typedoc": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@algorandfoundation/log-store": "workspace:*",
    "@tanstack/store": "catalog:",
    "before-after-hook": "catalog:"
  },
  "peerDependenciesMeta": {
    "@algorandfoundation/log-store": {
      "optional": true
    }
  }
}
