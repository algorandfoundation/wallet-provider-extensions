{
	"name": "@algorandfoundation/secret-store",
	"version": "0.0.1",
	"description": "Basic Secrets Store for the Wallet Provider.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"clean": "rm -rf dist coverage node_modules",
		"lint": "biome check",
		"lint:fix": "biome check --fix",
		"docs": "typedoc",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"bench": "vitest bench"
	},
	"author": "Algorand Foundation",
	"license": "Apache-2.0",
	"files": [
		"*.js",
		"*.js.map",
		"*.d.ts",
		"*.d.ts.map",
		"src/*.ts",
		"!src/*.bench.ts",
		"!src/*.test.ts"
	],
	"dependencies": {
		"@algorandfoundation/wallet-provider": "0.0.1",
		"before-after-hook": "^4.0.0"
	},
	"peerDependencies": {
		"@tanstack/store": "^0.8.0"
	},
	"repository": {
		"type": "git",
		"directory": "secrets",
		"url": "https://github.com/algorandfoundation/wallet-provider-extensions.git"
	}
}
