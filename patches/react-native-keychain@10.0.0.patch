+ * absent or 0 the query is left completely untouched, preserving the previous behaviour of
+ * prompting on every read.
+ */
+void applyAuthenticationValidityDuration(NSMutableDictionary *query, NSDictionary * __nullable options)
+{
+#if TARGET_OS_IOS || TARGET_OS_VISION
