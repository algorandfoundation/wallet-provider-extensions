+  if (duration <= 0) {
+    return;
+  }
+
+  LAContext *context = reusableAuthenticationContext(duration);
+  if (context != nil) {
+    query[(__bridge NSString *)kSecUseAuthenticationContext] = context;
+  }
+#endif
+}
