{
  "name": "@algorandfoundation/algorand-accounts-extension",
  "version": "0.0.0",
  "description": "Algorand accounts extension for wallet extensions.",
  "license": "Apache-2.0",
  "author": "Algorand Foundation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/algorandfoundation/wallet-provider-extensions.git",
    "directory": "accounts/algorand-extension"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -w -p tsconfig.build.json",
    "clean": "rm -rf dist coverage node_modules",
    "docs": "typedoc",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "bench": "vitest bench",
    "release": "package-releaser",
    "release:dry-run": "package-releaser --dry-run"
  },
  "dependencies": {
    "@algorandfoundation/accounts-core": "workspace:*",
    "@algorandfoundation/algokit-subscriber": "^4.0.0-beta.3",
    "@algorandfoundation/algokit-utils": "catalog:",
    "@algorandfoundation/keystore-core": "workspace:*",
    "@algorandfoundation/wallet-provider": "catalog:",
    "@noble/curves": "catalog:",
    "@noble/hashes": "catalog:",
    "algosdk": "catalog:"
  },
  "devDependencies": {
    "@algorandfoundation/logs": "workspace:*",
    "@algorandfoundation/package-releaser": "workspace:*",
    "@algorandfoundation/xhd-wallet-api": "catalog:",
    "@scure/base": "catalog:",
    "falcon-1024": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@algorandfoundation/logs": "workspace:*",
    "@tanstack/store": "catalog:",
    "before-after-hook": "catalog:"
  },
  "peerDependenciesMeta": {
    "@algorandfoundation/logs": {
      "optional": true
    }
  }
}
