	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"clean": "rm -rf dist coverage node_modules",
		"lint": "biome check",
		"lint:fix": "biome check --fix",
		"watch": "tsc -w",
		"test": "vitest run",
		"bench": "vitest bench"
	},
