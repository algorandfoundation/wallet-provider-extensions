{
  "name": "@algorandfoundation/identities",
  "version": "0.0.0",
  "description": "Meta package for the identities domain: the unified WithIdentities extension over the core store, with conditional platform exports.",
  "license": "Apache-2.0",
  "author": "Algorand Foundation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/algorandfoundation/wallet-provider-extensions.git",
    "directory": "identities/meta"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.native.d.ts",
        "default": "./dist/index.native.js"
      },
      "browser": {
        "types": "./dist/index.web.d.ts",
        "default": "./dist/index.web.js"
      },
      "node": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage node_modules docs",
    "docs": "typedoc",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "release": "package-releaser",
    "release:dry-run": "package-releaser --dry-run"
  },
  "dependencies": {
    "@algorandfoundation/identities-core": "workspace:*"
  },
  "devDependencies": {
    "@algorandfoundation/identities-connections-extension": "workspace:*",
    "@algorandfoundation/identities-keystore-extension": "workspace:*",
    "@algorandfoundation/keystore-core": "workspace:*",
    "@algorandfoundation/package-releaser": "workspace:^",
    "@algorandfoundation/wallet-provider": "catalog:",
    "typedoc": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@algorandfoundation/identities-connections-extension": "workspace:*",
    "@algorandfoundation/identities-keystore-extension": "workspace:*",
    "@algorandfoundation/keystore-core": "workspace:*",
    "@tanstack/store": "catalog:",
    "before-after-hook": "catalog:"
  },
  "peerDependenciesMeta": {
    "@algorandfoundation/identities-connections-extension": {
      "optional": true
    },
    "@algorandfoundation/identities-keystore-extension": {
      "optional": true
    },
    "@algorandfoundation/keystore-core": {
      "optional": true
    }
  }
}
